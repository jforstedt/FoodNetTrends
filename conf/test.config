/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run FoodNetTrends -profile test,singularity --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Model parameters tuned for fast test execution
    chains        = 2
    iterations    = 50
    adapt_delta   = 0.90
    max_treedepth = 8
    seed          = 42

    // Test pathogen subset (small, fast to fit)
    // Use uppercase to match standardized pathogen names from preprocess.R
    pathogen      = 'CAMPYLOBACTER'

    // Skip dashboard generation during tests
    skip_dashboard = true

    // Output
    outdir = 'test_output'
    projID = 'test_run'
}
