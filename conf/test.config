/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    Uses synthetic data in test_data/ -- see test_data/README.md for details.

    Use as follows:
        nextflow run FoodNetTrends -profile test,singularity --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data -- synthetic pre-cleaned CSV files
    mmwrFile     = "${projectDir}/test_data/test_mmwr.csv"
    censusFileB  = "${projectDir}/test_data/test_census_bacterial.csv"
    censusFileP  = "${projectDir}/test_data/test_census_parasitic.csv"

    // Skip preprocessing; use the CSV directly as cleaned data
    preprocessed = true
    cleanFile    = "${projectDir}/test_data/test_mmwr.csv"

    // Pathogen subset (two pathogens to exercise multi-pathogen logic)
    pathogen = 'CAMPYLOBACTER,SALMONELLA'

    // Minimal MCMC settings for fast execution
    chains        = 1
    iterations    = 100
    adapt_delta   = 0.8
    max_treedepth = 8
    seed          = 42

    // Include dashboard generation in test (set true to skip for faster runs)
    skip_dashboard = false

    // Output
    outdir = 'test_output'
    projID = 'test_run'

    // Limit resources so that this can run on GitHub Actions / small VMs
    max_cpus   = 2
    max_memory = '8.GB'
    max_time   = '1.h'
}
