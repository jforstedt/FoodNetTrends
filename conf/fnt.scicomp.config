/*
==========================================================================================
    Nextflow config file for FoodNetTrends on CDC HPC
==========================================================================================
    Based on CDC SciComp standard config (v2.0.0). Customized with FoodNetTrends-specific
    resource profiles for MCMC modeling workloads on Sun Grid Engine.
----------------------------------------------------------------------------------------
*/

params {
  config_profile_description = 'FoodNetTrends @ CDC SciComp'
  config_profile_contact = 'OAMD'
  config_profile_url = 'https://info.biotech.cdc.gov/info/'
  custom_config_version = 'master'
}

profiles {
  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true

    docker.enabled         = false
    conda.enabled          = false
    podman.enabled         = false
    shifter.enabled        = false
    charliecloud.enabled   = false

    process {
        scratch = false
    }
  }
  conda {
    conda.enabled = true
    conda.useMamba = false
    conda.createTimeout    = "120 min"

    docker.enabled         = false
    singularity.enabled    = false
    podman.enabled         = false
    shifter.enabled        = false
    charliecloud.enabled   = false

    process {
      beforeScript = 'source /etc/profile; eval "$(conda shell.bash hook)"'
      module = ['miniconda/24.11.1']
    }
  }
  // Local profile for small-scale testing on interactive qlogin sessions
  local {
    resourceLimits = [
        cpus: 4,
        memory: '16.GB',
        time: '4.h'
    ]
    executor {
      name = 'local'
      queueSize = 4
    }
    process {
      memory = '16.GB'
      cpus = 1
      time = '4.h'
    }
  }
  scicomp_rosalind {
    resourceLimits = [
        cpus: 44,
        memory: '356.GB',
        time: '28.day'
    ]

    executor {
      name = 'sge'
      queueSize = 100
      pollInterval = '10sec'
      submitRateLimit = '10/1min'
    }

    env {
        TMP = "/scicomp/scratch/${USER}/nextflow/tmp"
        TMPDIR = "/scicomp/scratch/${USER}/nextflow/tmp"
    }

    process {
      memory = '16.GB'
      cpus = 1
      time = '12.h'

      penv = 'smp'
      queue = { task.time <= 4.h ? 'short.q' : task.time > 3.day ? 'long.q' : 'all.q' }

      docker.enabled = false

      // +16 GB headroom prevents SGE memory allocation errors
      clusterOptions = { "-l h_vmem=${(task.memory.toGiga() + 16).toString()}G" }

      // TRENDY resource allocation is handled by modules.config (difficulty-based profiling)
      // Do not override here — modules.config loads last and is the authority
    }
  }
  // Use with scicomp_rosalind: -profile singularity,scicomp_rosalind,training
  training {
    process {
      queue = 'training.q'
    }
  }
  debug {
    dumpHashes = true
    cleanup = false
    nextflow.enable.configProcessNamesValidation = true

    process {
      shell = ['/bin/bash', '-x']
      beforeScript = 'echo $HOSTNAME'
    }

    env {
      NXF_DEBUG = '3'
    }
  }
}

/*
==========================================================================================
    Special queue labels
==========================================================================================
*/

process {
  withLabel: 'process_gpu' {
    queue = 'gpu.q'
    memory = '24.GB'
    cpus = 1
    time = '8.h'
    penv = ''
    resourceLimits = [
        cpus: 20,
        memory: '105.GB',
        time: '48.h'
    ]
    singularity.runOptions = "--nv"
  }

  withLabel: 'process_extralong' {
    queue = 'extralong.q'
    cpus = 1
    memory = '16.GB'
    time = '29.day'
    resourceLimits = [
        cpus: 16,
        memory: '356.GB',
        time: '84.day'
    ]
  }

  withLabel: 'process_highmem' {
    queue = 'highmem.q'
    cpus = 1
    memory = '400.GB'
    time = '8.h'
    resourceLimits = [
        cpus: 56,
        memory: '734.GB',
        time: '28.day'
    ]
  }
}
