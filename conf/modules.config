/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'TRENDY' {
        publishDir = [
            path: { "${params.outdir}/${params.projID}/spline_results" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        
        // Allocate one CPU per chain -- Stan runs one chain per core.
        // No retry multiplier: more cores won't help a failing model.
        cpus = { check_max(params.chains ?: 2, 'cpus') }
        
        memory = {
            def complexity = task.ext.dataMetrics?.complexity ?: 100000
            def rows = task.ext.dataMetrics?.rows ?: 10000
            
            // Memory allocation based on complexity score
            if (complexity > 1000000) {
                return check_max(96.GB * task.attempt, 'memory')
            } else if (complexity > 500000) {
                return check_max(64.GB * task.attempt, 'memory')
            } else if (complexity > 100000) {
                return check_max(48.GB * task.attempt, 'memory')
            } else if (rows > 5000) {
                return check_max(32.GB * task.attempt, 'memory')
            } else {
                return check_max(16.GB * task.attempt, 'memory')
            }
        }
        
        time = {
            def complexity = task.ext.dataMetrics?.complexity ?: 100000
            
            // Time allocation based on complexity
            if (complexity > 1000000) {
                return check_max(48.h * task.attempt, 'time')
            } else if (complexity > 500000) {
                return check_max(24.h * task.attempt, 'time')
            } else {
                return check_max(12.h * task.attempt, 'time')
            }
        }
    }

    withName: 'DASHBOARD' {
        publishDir = [
            path: { "${params.outdir}/${params.projID}" },
            mode: params.publish_dir_mode,
            pattern: 'dashboard.html'
        ]
    }
}
